{
  "name": "pi-devcontainer-sandbox",
  "version": "0.1.4",
  "description": "Routes pi tools into Podman dev containers",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "type": "extension",
    "name": "dev-container-sandbox",
    "entry": "extensions/dev-container-sandbox/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "npm run lint && npm test",
    "deploy": "npm run check && cp extensions/dev-container-sandbox/*.ts \"$HOME/.pi/agent/extensions/dev-container-sandbox/\""
  },
  "files": [
    "extensions/dev-container-sandbox/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
