{
  "name": "pi-devcontainer-sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "npm run lint && npm test",
    "deploy": "npm run check && cp extensions/dev-container-sandbox/*.ts \"$HOME/.pi/agent/extensions/dev-container-sandbox/\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
